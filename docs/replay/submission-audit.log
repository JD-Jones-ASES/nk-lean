NK.IntervalAlphabet.mem_translate_support {k M : ℕ} (A : NK.IntervalAlphabet k M) (t x : ℕ) :
  x ∈ (A.translate t).support ↔ ∃ a, (↑a + t) % M = x
NK.IntervalAlphabet.translate_interval {k M : ℕ} (A : NK.IntervalAlphabet k M) (t : ℕ) (a : A.Letter)
  (ha : (↑a + t) % M ∈ (A.translate t).support) : (A.translate t).interval ((↑a + t) % M) ha = A.letterInterval a
NK.IntervalAlphabet.mem_reflect_support {k M : ℕ} (A : NK.IntervalAlphabet k M) (x : ℕ) :
  x ∈ A.reflect.support ↔ ∃ a, (M - ↑a) % M = x
NK.IntervalAlphabet.reflect_interval {k M : ℕ} (A : NK.IntervalAlphabet k M) (a : A.Letter)
  (ha : (M - ↑a) % M ∈ A.reflect.support) : A.reflect.interval ((M - ↑a) % M) ha = (A.letterInterval a).reflect
