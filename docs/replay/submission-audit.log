NK.BinaryGlue.glue {m : ℕ} (A : Fin 4 → NK.IntervalAlphabet 2 (4 ^ m)) (hm : 1 ≤ m) (L R : Fin 8 → ℝ)
  (hinside :
    ∀ (p : NK.BinaryGlue.Point A),
      L (NK.BinaryGlue.parityClass A p) ≤ (NK.BinaryGlue.pointInterval A p).left ∧
        (NK.BinaryGlue.pointInterval A p).left + (NK.BinaryGlue.pointInterval A p).width ≤
          R (NK.BinaryGlue.parityClass A p))
  (hcycle :
    ∀ (p q : NK.BinaryGlue.Point A),
      (↑(NK.BinaryGlue.parityClass A p) + 1) % 8 = ↑(NK.BinaryGlue.parityClass A q) →
        R (NK.BinaryGlue.parityClass A p) ≤ L (NK.BinaryGlue.parityClass A q)) :
  NK.IntervalAlphabet 2 (4 ^ (m + 1))
NK.BinaryGlue.glue_moment {m : ℕ} (A : Fin 4 → NK.IntervalAlphabet 2 (4 ^ m)) (hm : 1 ≤ m) (L R : Fin 8 → ℝ)
  (hinside :
    ∀ (p : NK.BinaryGlue.Point A),
      L (NK.BinaryGlue.parityClass A p) ≤ (NK.BinaryGlue.pointInterval A p).left ∧
        (NK.BinaryGlue.pointInterval A p).left + (NK.BinaryGlue.pointInterval A p).width ≤
          R (NK.BinaryGlue.parityClass A p))
  (hcycle :
    ∀ (p q : NK.BinaryGlue.Point A),
      (↑(NK.BinaryGlue.parityClass A p) + 1) % 8 = ↑(NK.BinaryGlue.parityClass A q) →
        R (NK.BinaryGlue.parityClass A p) ≤ L (NK.BinaryGlue.parityClass A q))
  (f : ℝ) : (NK.BinaryGlue.glue A hm L R hinside hcycle).moment f = ∑ r, (A r).moment f
